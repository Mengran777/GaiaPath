// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("POSTGRES_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

model User {
  id             String          @id @default(uuid())
  username       String          @unique
  email          String          @unique
  password       String
  trips          Trip[]
  favoriteRoutes FavoriteRoute[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Trip {
  id            String    @id @default(uuid())
  name          String
  startDate     DateTime  @map("start_date") @db.Date // date only, no time
  endDate       DateTime  @map("end_date") @db.Date    // date only, no time
  routeId       String?   @map("route_id")             // AI-generated route ID
  itineraryData String?   @map("itinerary_data") @db.Text // JSON: DayItinerary[] (includes user edits)
  routeMeta     String?   @map("route_meta") @db.Text     // JSON: route metadata (badge, highlights, etc.)

  userId    String
  user      User      @relation(fields: [userId], references: [id])

  locations Location[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("trips")
}

// A single location/activity within a trip
model Location {
  id          String   @id @default(uuid())
  name        String
  description String?
  latitude    Float
  longitude   Float
  notes       String?
  order       Int      @default(0)
  time        String?
  rating      Float?
  price       String?  // e.g. "Free" or a price string
  imageUrl    String?

  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("locations")
}

model FavoriteRoute {
  id        String   @id @default(uuid())
  routeId   String   @map("route_id")   // AI-generated route ID
  routeData String   @map("route_data") @db.Text // full route JSON

  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, routeId]) // one favorite per user per route
  @@map("favorite_routes")
}

// RAG corpus: real points of interest per destination, used for embedding retrieval
model PointOfInterest {
  id          String                      @id @default(uuid())
  destination String                      // normalized slug, e.g. "new-york"
  name        String
  description String                      @db.Text
  category    String?                     // classic / culture / nature / food
  latitude    Float
  longitude   Float
  embedding   Unsupported("vector(3072)") // native pgvector; not readable/writable via Prisma Client, use $queryRaw/$executeRaw
  source      String                      @default("manual")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt     @map("updated_at")

  @@unique([destination, name])
  @@index([destination])
  @@map("points_of_interest")
}
